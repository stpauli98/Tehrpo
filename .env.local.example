# Brending (demo / rebrand) — ako je prazno, prikazuje se "Tehpro"
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_TAGLINE=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bazni URL dashboarda za linkove u email-podsjetnicima (po deploymentu; bez ovoga dugmada se izostave)
NEXT_PUBLIC_APP_URL=https://primjer-dashboard.domena

# Migrations / scripts only — Supavisor transaction pooler (port 6543)
DATABASE_URL=

# Email podsjetnici (Faza 6)
RESEND_API_KEY=re_xxx
EMAIL_FROM=Tehpro <onboarding@resend.dev>
REMINDER_TO=tehpro@example.com
CRON_SECRET=promijeni-me
# Throttling podsjetnika (prazno = defaulti za Resend free: 90/run, grupe od 2, pauza 1100ms).
# Podigni kad nadogradiš Resend (npr. 1000 / 10 / 100).
REMINDER_MAX_PER_RUN=
REMINDER_BATCH_SIZE=
REMINDER_BATCH_DELAY_MS=

# AI zapisnik (Faza Dokumenti)
ANTHROPIC_API_KEY=
# Postavi na "1" da forsiraš mock zapisnik (E2E ga postavlja automatski)
ZAPISNIK_DRY_RUN=
# Postavi na "1" da forsiraš mock chat odgovore (E2E ga postavlja automatski)
CHAT_DRY_RUN=
