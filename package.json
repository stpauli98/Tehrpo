{
  "name": "tehpro-mvp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000 --webpack",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test --workers=1",
    "test:e2e:ui": "playwright test --ui",
    "db:types": "supabase gen types typescript --local > db/types.ts",
    "db:reset": "supabase db reset",
    "seed": "tsx --env-file=.env.local --env-file=.env.development.local scripts/seed-from-excel.ts",
    "backfill:grad": "tsx --env-file=.env.local scripts/backfill-lokacija-grad.ts",
    "dedup:termini": "tsx --env-file=.env.local scripts/dedup-termini.ts",
    "cleanup:test-data": "tsx --env-file=.env.local --env-file=.env.development.local scripts/cleanup-test-data.ts",
    "reminders": "tsx --env-file=.env.local scripts/send-reminders.ts",
    "preview:emails": "tsx --env-file=.env.local scripts/preview-emails.ts",
    "preview:import": "tsx --env-file=.env.local scripts/preview-import.ts",
    "db:apply-cloud": "tsx --env-file=.env.local scripts/apply-cloud-migration.ts",
    "ugasi:nerutabilne": "tsx --env-file=.env.local scripts/ugasi-nerutabilne-podsjetnike.ts",
    "db:tijelo": "tsx --env-file=.env.local scripts/ispisi-tijelo.ts",
    "rls:check": "tsx scripts/check-rls-coverage.ts",
    "seed:admin": "tsx --env-file=.env.local scripts/seed-admin.ts",
    "gc:dokumenti": "tsx --env-file=.env.local scripts/gc-orphan-dokumenti.ts",
    "provjeri:integraciju": "tsx scripts/provjeri-integraciju.ts",
    "audit:sql": "tsx --env-file=.env.local scripts/audit-upit.ts",
    "audit:proba": "tsx --env-file=.env.local scripts/audit-proba-migracija.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@base-ui/react": "^1.6.0",
    "@supabase/ssr": "^0.12.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tanstack/react-query": "^5.101.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "^9.7.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^1.21.0",
    "mammoth": "^1.12.0",
    "next": "16.2.11",
    "next-intl": "^4.13.1",
    "next-themes": "^0.4.6",
    "pdf-lib": "^1.17.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.14.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.9",
    "eslint": "^9",
    "eslint-config-next": "16.2.9",
    "pg": "^8.22.0",
    "postcss": "^8.5.18",
    "shadcn": "^4.11.0",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5",
    "vitest": "^4.1.9"
  }
}
