# Brending (demo / rebrand) — ako je prazno, prikazuje se "Tehpro"
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_TAGLINE=

# Demo režim — NIJEDAN mejl se ne šalje; slanja se samo bilježe (status "demo") da bi
# tab „Poslati mejlovi" pokazao kako bi izgledali, uz vidljivo objašnjenje korisniku.
# Postavlja se ISKLJUČIVO na DEMO deployu. NIKAD na produkciji — tamo bi tiho ugasio
# sve podsjetnike. Uključuje ga samo tačna vrijednost "1".
# NEXT_PUBLIC_DEMO_MODE=1

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Bazni URL dashboarda za linkove u email-podsjetnicima (po deploymentu; bez ovoga dugmada se izostave)
NEXT_PUBLIC_APP_URL=https://primjer-dashboard.domena

# Migrations / scripts only — Supavisor transaction pooler (port 6543)
DATABASE_URL=

# Email podsjetnici (Faza 6)
RESEND_API_KEY=re_xxx
EMAIL_FROM=Tehpro <onboarding@resend.dev>
REMINDER_TO=tehpro@example.com
CRON_SECRET=promijeni-me
# RESEND_WEBHOOK_SECRET=whsec_...
# Throttling podsjetnika (prazno = defaulti za Resend free: 90/run, grupe od 2, pauza 1100ms).
# Podigni kad nadogradiš Resend (npr. 1000 / 10 / 100).
REMINDER_MAX_PER_RUN=
REMINDER_BATCH_SIZE=
REMINDER_BATCH_DELAY_MS=

# AI zapisnik (Faza Dokumenti)
ANTHROPIC_API_KEY=
# Postavi na "1" da forsiraš mock zapisnik (E2E ga postavlja automatski)
ZAPISNIK_DRY_RUN=
# Postavi na "1" da forsiraš mock chat odgovore (E2E ga postavlja automatski)
CHAT_DRY_RUN=

# Noćno metenje osirotjelih fajlova iz storage-a (/api/cron/ciscenje-storagea).
# Prazno = PROBNI prolaz (samo log + izvještaj, ništa se ne briše). Postavi na "1"
# tek kad si u logovima vidio šta bi prolaz obrisao — brisanje je nepovratno.
CISCENJE_STORAGEA_APPLY=

# Storage bucket za dokumente. Ime CURI korisniku — potpisani URL glasi
# `/object/sign/<bucket>/…` i stoji u adresnoj traci pri otvaranju dokumenta.
# Demo instance moraju imati neutralno ime; prazno = "tehpro-dokumenti".
DOKUMENTI_BUCKET=dokumenti

# Firmin (klijentski) email brend — koristi se SAMO u mejlu koji ide firmama.
# Nezavisno od NEXT_PUBLIC_APP_NAME (koji na demu = "Demo").
# NA DEMO INSTANCAMA OBAVEZNO POSTAVITI — prazno pada na "TEHPRO".
FIRM_BRAND_NAME=TEHPRO
FIRM_BRAND_TAGLINE=Zaštita na radu i zaštita od požara
# FIRM_CONTACT_EMAIL=info@tehpro.ba
# FIRM_CONTACT_PHONE=+387 51 000 000
# FIRM_CONTACT_WEB=https://tehpro.ba
